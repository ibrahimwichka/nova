# Copy to .env. Keep the real key out of Git and out of browser code.
OPENROUTER_API_KEY=
# Strong task-specific defaults; override any model without exposing keys to the browser.
OPENROUTER_PREP_MODEL=openai/gpt-6.1-terra
OPENROUTER_INVENTORY_MODEL=openai/gpt-6.1-terra
OPENROUTER_STAFF_MODEL=anthropic/claude-opus-5.5
OPENROUTER_FINANCE_MODEL=anthropic/claude-opus-5.5
OPENROUTER_VISION_MODEL=google/gemini-4-argon
OPENROUTER_RECEIPT_MODEL=google/gemini-4-argon
PORT=3000
# Set to 0.0.0.0 to let the other two computers view this server on your LAN.
# Keep the camera on this host computer at http://localhost:3000.
HOST=127.0.0.1
